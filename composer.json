{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nicollasfrazao/bway",
    "type": "project",
    "description": "Shopping-list app that orders a supermarket visit by sector, with routes computed by A* over a mapped floor plan.",
    "keywords": [
        "laravel",
        "shopping-list",
        "a-star",
        "routing"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.23",
        "icanhazstring/composer-unused": "^0.9.8",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpmd/phpmd": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5.12",
        "povils/phpmnd": "^3.6",
        "rector/rector": "^2.8",
        "shipmonk/dead-code-detector": "^1.4",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0",
        "tomasvotruba/cognitive-complexity": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "@lint:pint",
            "@lint:phpcs"
        ],
        "lint:pint": "pint --test",
        "lint:phpcs": "phpcs",
        "analyse": [
            "@analyse:phpstan",
            "@analyse:phpmd",
            "@analyse:magic-numbers",
            "@analyse:rector"
        ],
        "analyse:phpstan": "phpstan analyse --memory-limit=1G --no-progress",
        "analyse:phpmd": "phpmd analyze --ruleset=phpmd.xml app database routes phpcs/Bway",
        "analyse:magic-numbers": "phpmnd app routes phpcs/Bway --extensions=all",
        "analyse:rector": "rector process --dry-run --no-progress-bar",
        "check:architecture": "deptrac analyse --no-progress --fail-on-uncovered --report-uncovered",
        "check:unused": "composer-unused --no-progress",
        "check:context": "@php artisan context:check",
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "pest"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi @no_additional_args",
            "pest --coverage --min=80"
        ],
        "fix": [
            "pint",
            "phpcbf || true",
            "rector process --no-progress-bar"
        ],
        "gate": [
            "@lint",
            "@analyse",
            "@check:architecture",
            "@check:unused",
            "@test:coverage",
            "@composer audit",
            "@check:context"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "lint": "Pint (check mode) and PHP_CodeSniffer",
        "analyse": "PHPStan (Larastan max), PHPMD, magic numbers and a Rector dry run",
        "check:architecture": "Deptrac layer rules",
        "check:unused": "Composer packages nothing uses",
        "check:context": "Agent surfaces are copies of .context/docs/README.md",
        "test": "Pest",
        "test:coverage": "Pest with the 80% line coverage gate (pcov)",
        "fix": "Apply Pint, PHP_CodeSniffer and Rector fixes",
        "gate": "The whole PHP quality gate, one check after another, as CI runs it"
    }
}
